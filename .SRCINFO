pkgbase = arqueon-desktop-assets
	pkgdesc = Curated desktop assets (meta packages)
	pkgver = 1.1.0
	pkgrel = 2
	url = https://github.com/arqueon/desktop-assets
	arch = any
	license = MIT

pkgname = arqueon-desktop-assets
	pkgdesc = Curated desktop assets — everything
	depends = arqueon-desktop-engine
	depends = arqueon-desktop-icons
	depends = arqueon-desktop-themes
	depends = arqueon-desktop-unified
	depends = arqueon-desktop-qt
	depends = arqueon-desktop-cursors
	depends = arqueon-desktop-fonts
	depends = arqueon-desktop-login

pkgname = arqueon-desktop-engine
	pkgdesc = Dynamic colour engine: Material You generation and folder recolouring
	depends = matugen
	depends = papirus-folders

pkgname = arqueon-desktop-icons
	pkgdesc = Icon themes: Papirus as the working set, Adwaita/Breeze as fallback
	depends = papirus-icon-theme
	depends = adwaita-icon-theme
	depends = breeze-icons
	optdepends = tela-icon-theme: flat, colourful alternative
	optdepends = colloid-icon-theme-git: closest match to a Material shell
	optdepends = qogir-icon-theme-git: muted Material alternative
	optdepends = fluent-icon-theme-git: Windows 11 look
	optdepends = kora-icon-theme: elegant, well maintained
	optdepends = papirus-folders-catppuccin-git: Catppuccin folder accents for Papirus
	optdepends = morewaita-icon-theme: adds app icons on top of Adwaita without replacing it; AUR package maintained by the upstream author
	optdepends = adwaita-colors-icon-theme: accent-coloured Adwaita folders (GNOME 47+ style), same author as MoreWaita
	optdepends = vimix-icon-theme: Material flavour, vinceliuice, alive (2025.08)
	optdepends = whitesur-icon-theme-git: completes the WhiteSur look

pkgname = arqueon-desktop-themes
	pkgdesc = GTK themes. GTK4/libadwaita takes colour only — see the note below
	depends = adw-gtk-theme
	optdepends = catppuccin-gtk-theme-git: Catppuccin, 9 accents in light and dark
	optdepends = colloid-gtk-theme-git: Material-flavoured, actively maintained
	optdepends = orchis-theme: rounded Material theme (official repo)
	optdepends = fluent-gtk-theme-git: Windows 11 look
	optdepends = whitesur-gtk-theme-git: macOS look
	optdepends = graphite-gtk-theme-git: flat, high-contrast
	optdepends = gruvbox-gtk-theme-git: Gruvbox palette (Fausto-Korpsvart family)
	optdepends = tokyonight-gtk-theme-git: Tokyo Night palette (Fausto-Korpsvart family)
	optdepends = everforest-gtk-theme-git: Everforest palette (Fausto-Korpsvart family)
	optdepends = kanagawa-gtk-theme-git: Kanagawa palette (Fausto-Korpsvart family)
	optdepends = rose-pine-gtk-theme: Rose Pine palette

pkgname = arqueon-desktop-unified
	pkgdesc = Qt apps that pass for GTK: Kvantum with same-author theme pairs and Adwaita CSDs
	depends = kvantum
	depends = kvantum-theme-libadwaita-git
	depends = qadwaitadecorations-qt6
	optdepends = kvantum-qt5: Kvantum for the remaining Qt5 apps
	optdepends = kvantum-theme-whitesur-git: pairs with whitesur-gtk-theme-git (same author)
	optdepends = kvantum-theme-orchis-git: pairs with orchis-theme (same author)
	optdepends = kvantum-theme-catppuccin-git: 56 variants, pairs with catppuccin-gtk-theme-git
	optdepends = kvantum-theme-materia: pairs with materia-gtk-theme, both official repos
	optdepends = materia-gtk-theme: the GTK half of the Materia pair
	optdepends = qt6ct-kde: the non-Kvantum half of the story — parses the KColorScheme palette DMS exports, which stock qt6ct silently cannot

pkgname = arqueon-desktop-qt
	pkgdesc = Qt5/Qt6 consistency on a non-KDE Wayland session
	depends = qt5ct
	depends = qt6ct
	optdepends = qt6ct-kde: drop-in qt6ct (provides/conflicts it) that parses the KColorScheme palette DMS exports — dms-theme-sync 0.7 builds its kcolorscheme route on it
	optdepends = qt6-tools: provides qtdiag, which dms-theme-sync uses to list the platform themes and styles Qt can load

pkgname = arqueon-desktop-cursors
	pkgdesc = Cursor themes
	depends = catppuccin-cursors-mocha
	optdepends = catppuccin-cursors-latte: light-mode counterpart
	optdepends = bibata-cursor-theme: the classic shape (upstream quiet since 2024)
	optdepends = capitaine-cursors: neutral, complete, good at HiDPI
	optdepends = phinger-cursors: soft alternative
	optdepends = adwaita-cursors: GNOME default, fallback
	optdepends = vimix-cursors: vinceliuice, official repo — closes the all-vinceliuice look
	optdepends = nordzy-cursors: Vimix-derived, alive (2.5.0, 2026-04)
	optdepends = xcursor-simp1e: minimal, consistent
	optdepends = googledot-cursor-theme: Google-style dot cursor
	optdepends = notwaita-cursor-theme: Adwaita-flavoured alternative

pkgname = arqueon-desktop-fonts
	pkgdesc = Coding, UI and document fonts, with Nerd glyphs by fallback
	depends = otf-cascadia-code
	depends = ttf-jetbrains-mono
	depends = ttf-nerd-fonts-symbols
	depends = ttf-roboto
	depends = inter-font
	depends = adobe-source-serif-fonts
	depends = noto-fonts
	depends = noto-fonts-cjk
	depends = noto-fonts-emoji
	depends = ttf-liberation
	optdepends = maplemono-nf: rounded coding font with the best ligatures and real italics
	optdepends = maplemono-variable: the same, unpatched, as a variable font
	optdepends = ttf-monaspace-variable: five-style superfamily with texture healing, variable axes (official repo; replaces otf-monaspace)
	optdepends = ttf-iosevka-nerd: narrow, fits more columns
	optdepends = ttf-fira-code: classic ligature font
	optdepends = ttf-jetbrains-mono-nerd: patched JetBrains Mono, for terminals without font fallback
	optdepends = adwaita-fonts: GNOME Adwaita Sans and Mono
	optdepends = otf-geist-mono-nerd: Vercel Geist Mono with Nerd glyphs (official repo)
	optdepends = ttf-geist: Geist as UI sans, alive (1.8.0)
	optdepends = ttf-geist-mono-variable: Geist Mono, variable build
	optdepends = otf-intel-one-mono: high-legibility mono (cachyos repo; AUR on vanilla Arch)
	optdepends = ttf-commit-mono: neutral, spacing-tuned mono
	optdepends = ttf-0xproto: distinctive-glyph mono, alive (2.502)
	optdepends = ttf-manrope: geometric UI sans, alive (2026-05)

pkgname = arqueon-desktop-fonts-pairings
	pkgdesc = Two document typeface pairings (sans + serif + mono)
	depends = ttf-archivo-variable
	depends = ttf-archivo-narrow
	depends = ttf-piazzolla-variable
	depends = ttf-impallari-libre-franklin
	depends = adobe-source-serif-fonts
	depends = ttf-spline-sans-mono

pkgname = arqueon-desktop-login
	pkgdesc = Login and boot theming: SDDM and Plymouth (all optional)
	optdepends = sddm-silent-theme: modern SDDM theme, alive (1.5.0, 2026-06)
	optdepends = where-is-my-sddm-theme-git: the minimal SDDM alternative
	optdepends = plymouth-theme-catppuccin-mocha-git: boot splash from the Catppuccin project itself
